{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "Inventory product item in Sappy Stationary POS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "description": { "type": "string" },
        "unit": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "stock"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sales transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "grandTotal": { "type": "number" },
        "subtotal": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["receiptNumber", "grandTotal", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Staff profile with role and PIN",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "pin": { "type": "string" },
        "approvalStatus": { "type": "string" }
      },
      "required": ["name", "email", "role", "pin"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Store operational expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["amount", "category", "date"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Store configuration and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeName": { "type": "string" },
        "currencySymbol": { "type": "string" }
      },
      "required": ["storeName", "currencySymbol"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "entity": "Item"
    },
    "/sales/{saleId}": {
      "entity": "Sale"
    },
    "/users/{userId}": {
      "entity": "User"
    },
    "/expenses/{expenseId}": {
      "entity": "Expense"
    },
    "/settings/{settingId}": {
      "entity": "Setting"
    }
  }
}
